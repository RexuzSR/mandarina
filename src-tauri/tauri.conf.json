{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mandarina",
  "version": "0.2.0",
  "identifier": "dev.mandarina.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "overlay", "url": "index.html",
        "transparent": true, "decorations": false, "alwaysOnTop": true,
        "skipTaskbar": true, "visible": false, "focus": false,
        "shadow": false, "resizable": false, "dragDropEnabled": false
      },
      {
        "label": "progress", "url": "progress.html",
        "transparent": true, "decorations": false, "alwaysOnTop": true,
        "skipTaskbar": true, "visible": false, "focus": false,
        "shadow": false, "resizable": false, "dragDropEnabled": false,
        "width": 340, "height": 120
      }
    ]
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
